Функция ИзмеритьОтчет() Экспорт
    Отчет = Отчеты.ЗапчастиНаСкладе.Создать();
    Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
    Настройки = Схема.ВариантыНастроек[0].Настройки;
    Строки = Сформировать(Схема, Настройки);
    НачальныеСтроки = Строки.Количество();
    Клиент = Справочники.Клиенты.НайтиПоНаименованию("Анна Смирнова", Истина);
    Мастер = Справочники.Мастера.НайтиПоНаименованию("Иван Петров", Истина);
    Итог = "OK" + Символы.ПС + "Позиций в отчёте;Добавленных резервов;Замеры, мс;Медиана, мс";
    УжеСоздано = 0;
    Для Каждого Объем Из СтрРазделить("100,400,900", ",") Цикл
        Количество = Число(Объем);
        ПоследняяЗапчасть = СоздатьПартию(УжеСоздано, Количество, Клиент, Мастер);
        Строки = Сформировать(Схема, Настройки);
        ПоследняяСтрока = Строки.Найти(ПоследняяЗапчасть, "Запчасть");
        Если Строки.Количество() <> НачальныеСтроки + Количество Или ПоследняяСтрока = Неопределено
            Или ПоследняяСтрока.Количество <> 3 Или ПоследняяСтрока.ВРезерве <> 2
            Или ПоследняяСтрока.Доступно <> 1 Тогда
            ВызватьИсключение "Подготовка данных для замера дала неверные остатки.";
        КонецЕсли;
        Замеры = Новый СписокЗначений;
        ТекстЗамеров = Новый Массив;
        Для Номер = 1 По 7 Цикл
            НачалоЗамера = ТекущаяУниверсальнаяДатаВМиллисекундах();
            Строки = Сформировать(Схема, Настройки);
            Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоЗамера;
            Замеры.Добавить(Длительность);
            ТекстЗамеров.Добавить(Формат(Длительность, "ЧГ=0"));
        КонецЦикла;
        Замеры.СортироватьПоЗначению();
        Итог = Итог + Символы.ПС + СтрШаблон("%1;%2;%3;%4",
            Строки.Количество(), Количество, СтрСоединить(ТекстЗамеров, ", "), Замеры[3].Значение);
        УжеСоздано = Количество;
    КонецЦикла;
    Возврат Итог;
КонецФункции

Функция СоздатьПартию(Откуда, ДоКуда, Клиент, Мастер)
    Поступление = Документы.ПоступлениеЗапчастей.СоздатьДокумент();
    Поступление.Дата = ТекущаяДатаСеанса();
    Заявка = Документы.ЗаявкаНаРемонт.СоздатьДокумент();
    Заявка.Дата = Поступление.Дата;
    Заявка.Клиент = Клиент;
    Заявка.Мастер = Мастер;
    Заявка.Статус = Перечисления.СтатусыЗаявок.ВРаботе;
    Заявка.Устройство = "Стенд";
    Заявка.Неисправность = "Проверка производительности";
    Для Номер = Откуда + 1 По ДоКуда Цикл
        Запчасть = Справочники.Запчасти.СоздатьЭлемент();
        Запчасть.Наименование = "Стендовая запчасть " + Формат(Номер, "ЧГ=0");
        Запчасть.Записать();
        СтрокаПоступления = Поступление.Запчасти.Добавить();
        СтрокаПоступления.Запчасть = Запчасть.Ссылка;
        СтрокаПоступления.Количество = 3;
        СтрокаЗаявки = Заявка.Запчасти.Добавить();
        СтрокаЗаявки.Запчасть = Запчасть.Ссылка;
        СтрокаЗаявки.Количество = 2;
        СтрокаЗаявки.Цена = 1;
    КонецЦикла;
    Поступление.Записать(РежимЗаписиДокумента.Проведение);
    Заявка.РезервироватьЗапчасти = Истина;
    Заявка.ДополнительныеСвойства.Вставить("СогласоватьСмету", Истина);
    Заявка.Записать();
    Возврат Запчасть.Ссылка;
КонецФункции

Функция Сформировать(Схема, Настройки)
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = Компоновщик.Выполнить(Схема, Настройки,,,
        Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных;
    Процессор.Инициализировать(Макет);
    Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    Таблица = Новый ТаблицаЗначений;
    Вывод.УстановитьОбъект(Таблица);
    Вывод.Вывести(Процессор);
    Возврат Таблица;
КонецФункции
