			<field>Ремонт</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Запчасть</dataPath>
			<field>Запчасть</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Заказано</dataPath>
			<field>Заказано</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Получено</dataPath>
			<field>Получено</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОсталосьПолучить</dataPath>
			<field>ОсталосьПолучить</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    Строки.Ссылка КАК Заказ,
    Строки.Запчасть КАК Запчасть,
    СУММА(Строки.Количество) КАК КоличествоЗаказа
ПОМЕСТИТЬ ЗаказанныеПозиции
ИЗ
    Документ.ЗаказПоставщику.Запчасти КАК Строки
ГДЕ
    НЕ Строки.Ссылка.ПометкаУдаления
СГРУППИРОВАТЬ ПО
    Строки.Ссылка, Строки.Запчасть
;
ВЫБРАТЬ
    Строки.Ссылка.ЗаказПоставщику КАК Заказ,
    Строки.Запчасть КАК Запчасть,
    СУММА(Строки.Количество) КАК КоличествоПоставки
ПОМЕСТИТЬ ПолученныеПозиции
ИЗ
    Документ.ПоступлениеЗапчастей.Запчасти КАК Строки
ГДЕ
    Строки.Ссылка.Проведен
    И Строки.Ссылка.ЗаказПоставщику &lt;&gt; ЗНАЧЕНИЕ(Документ.ЗаказПоставщику.ПустаяСсылка)
СГРУППИРОВАТЬ ПО
    Строки.Ссылка.ЗаказПоставщику, Строки.Запчасть
;
ВЫБРАТЬ
    Позиции.Заказ КАК Заказ,
    Позиции.Заказ.Поставщик КАК Поставщик,
    Позиции.Заказ.ЗаявкаНаРемонт КАК Ремонт,
    Позиции.Запчасть КАК Запчасть,
    Позиции.КоличествоЗаказа КАК Заказано,
    ЕСТЬNULL(Поставки.КоличествоПоставки, 0) КАК Получено,
    Позиции.КоличествоЗаказа - ЕСТЬNULL(Поставки.КоличествоПоставки, 0) КАК ОсталосьПолучить
ИЗ
    ЗаказанныеПозиции КАК Позиции
    ЛЕВОЕ СОЕДИНЕНИЕ ПолученныеПозиции КАК Поставки
    ПО Позиции.Заказ = Поставки.Заказ И Позиции.Запчасть = Поставки.Запчасть
ГДЕ
    Позиции.КоличествоЗаказа &gt; ЕСТЬNULL(Поставки.КоличествоПоставки, 0)</query>
