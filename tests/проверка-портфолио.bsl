Процедура ПроверитьСценарий() Экспорт
    Клиент = Справочники.Клиенты.НайтиПоНаименованию("Анна Смирнова", Истина);
    Мастер = Справочники.Мастера.НайтиПоНаименованию("Иван Петров", Истина);
    Деталь = Справочники.Запчасти.НайтиПоНаименованию("Разъём питания", Истина);
    ПроверитьОстаток(Деталь, 3);
    ПроверитьОтборОтчета(Деталь);
    Шлейф = Справочники.Запчасти.НайтиПоНаименованию("Шлейф дисплея", Истина);
    ПроверитьДоступность(Шлейф, 7, 1, 6);
    ПроверитьРезервирование(Клиент, Мастер, Деталь);

    Заявка = Документы.ЗаявкаНаРемонт.СоздатьДокумент();
    Заявка.Дата = ТекущаяДатаСеанса();
    Заявка.Клиент = Клиент;
    Заявка.Устройство = "Тестовый ноутбук";
    Заявка.Неисправность = "Не заряжается";
    Заявка.Записать();
    ПроверитьСтатус(Заявка.Ссылка, Перечисления.СтатусыЗаявок.Новая);

    Заявка.Статус = Перечисления.СтатусыЗаявок.ВРаботе;
    ПроверитьОтказ(Заявка, РежимЗаписиДокумента.Запись, "Назначьте мастера");
    ПроверитьСтатус(Заявка.Ссылка, Перечисления.СтатусыЗаявок.Новая);
    Заявка.Мастер = Мастер;
    Заявка.Записать();
    ПроверитьСтатус(Заявка.Ссылка, Перечисления.СтатусыЗаявок.ВРаботе);

    СтрокаДеталей = Заявка.Запчасти.Добавить();
    СтрокаДеталей.Запчасть = Деталь;
    СтрокаДеталей.Количество = 4;
    Заявка.Статус = Перечисления.СтатусыЗаявок.Готова;
    ПроверитьОтказ(Заявка, РежимЗаписиДокумента.Проведение, "нужно 4, доступно 3");
    ПроверитьСтатус(Заявка.Ссылка, Перечисления.СтатусыЗаявок.ВРаботе);
    ПроверитьОстаток(Деталь, 3);

    СтрокаДеталей.Количество = 1;
    Заявка.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьСтатус(Заявка.Ссылка, Перечисления.СтатусыЗаявок.Готова);
    ПроверитьОстаток(Деталь, 2);
    Заявка.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьОстаток(Деталь, 2);
    Заявка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    ПроверитьОстаток(Деталь, 3);
    ПроверитьСметуИГарантию(Заявка.Ссылка, Клиент, Мастер, Деталь);
    ПроверитьЗакупку(Клиент, Мастер, Деталь);
КонецПроцедуры

Процедура ПроверитьРезервирование(Клиент, Мастер, Деталь)
    Первая = НоваяЗаявкаДляРезерва(Клиент, Мастер, Деталь);
    Вторая = НоваяЗаявкаДляРезерва(Клиент, Мастер, Деталь);
    Первая.РезервироватьЗапчасти = Истина;
    Первая.Записать();
    Первая.Записать();
    ПроверитьДоступность(Деталь, 3, 2, 1);

    Вторая.РезервироватьЗапчасти = Истина;
    ПроверитьОтказ(Вторая, РежимЗаписиДокумента.Запись, "нужно 2, доступно 1");
    ПроверитьДоступность(Деталь, 3, 2, 1);
    Заказ = Документы.ЗаказПоставщику.СоздатьДокумент();
    Заказ.Заполнить(Вторая.Ссылка);
    Если Заказ.Запчасти.Количество() <> 1 Или Заказ.Запчасти[0].Количество <> 1 Тогда
        ВызватьИсключение "Закупка не учла резерв другой заявки.";
    КонецЕсли;
    Вторая.Статус = Перечисления.СтатусыЗаявок.Готова;
    ПроверитьОтказ(Вторая, РежимЗаписиДокумента.Проведение, "доступно 1 с учётом резервов");
    ПроверитьДоступность(Деталь, 3, 2, 1);

    Первая.РезервироватьЗапчасти = Ложь;
    Первая.Записать();
    ПроверитьДоступность(Деталь, 3, 0, 3);
    Первая.РезервироватьЗапчасти = Истина;
    Первая.Записать();
    Первая.Статус = Перечисления.СтатусыЗаявок.Готова;
    Первая.Дата = ТекущаяДатаСеанса() + 86400;
    ПроверитьОтказ(Первая, РежимЗаписиДокумента.Проведение, "только текущей датой");
    ПроверитьДоступность(Деталь, 3, 2, 1);
    Первая = Первая.Ссылка.ПолучитьОбъект();
    Первая.Статус = Перечисления.СтатусыЗаявок.Готова;
    Первая.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьДоступность(Деталь, 1, 0, 1);
    Первая.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьДоступность(Деталь, 1, 0, 1);
    Первая.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    ПроверитьДоступность(Деталь, 3, 0, 3);
КонецПроцедуры

Функция НоваяЗаявкаДляРезерва(Клиент, Мастер, Деталь)
    Заявка = Документы.ЗаявкаНаРемонт.СоздатьДокумент();
    Заявка.Дата = ТекущаяДатаСеанса();
    Заявка.Клиент = Клиент;
    Заявка.Мастер = Мастер;
    Заявка.Устройство = "Тест резерва";
    Заявка.Неисправность = "Требуется замена разъёмов";
    Заявка.Статус = Перечисления.СтатусыЗаявок.ВРаботе;
    ДобавитьПозицию(Заявка, Деталь, 1);
    ДобавитьПозицию(Заявка, Деталь, 1);
    Заявка.Запчасти[0].Цена = 100;
    Согласовать(Заявка);
    Возврат Заявка;
КонецФункции

Процедура ПроверитьДоступность(Деталь, НаСкладе, ВРезерве, Доступно)
    Отчет = Отчеты.ЗапчастиНаСкладе.Создать();
    Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
    Настройки = Схема.ВариантыНастроек[0].Настройки;
    Отбор = Настройки.Отбор.Элементы[0];
    Отбор.ПравоеЗначение = Деталь;
    Отбор.Использование = Истина;
    Строки = СтрокиОтчета(Схема, Настройки);
    Если Строки.Количество() <> 1 Или Строки[0].Количество <> НаСкладе
        Или Строки[0].ВРезерве <> ВРезерве Или Строки[0].Доступно <> Доступно Тогда
        ВызватьИсключение СтрШаблон("Ожидалось на складе %1, в резерве %2, доступно %3.",
            НаСкладе, ВРезерве, Доступно);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗакупку(Клиент, Мастер, Деталь)
    Заявка = Документы.ЗаявкаНаРемонт.СоздатьДокумент();
    Заявка.Дата = ТекущаяДатаСеанса();
    Заявка.Клиент = Клиент;
    Заявка.Мастер = Мастер;
    Заявка.Устройство = "Тестовая закупка";
    Заявка.Неисправность = "Нужны четыре разъёма";
    Заявка.Статус = Перечисления.СтатусыЗаявок.ВРаботе;
    ДобавитьПозицию(Заявка, Деталь, 3);
    ДобавитьПозицию(Заявка, Деталь, 1);
    Заявка.Записать();

    // В предыдущем тесте списана ещё одна штука: фактический остаток равен двум.
    Заказ = Документы.ЗаказПоставщику.СоздатьДокумент();
    Заказ.Заполнить(Новый Структура("РемонтДляЗакупки", Заявка.Ссылка));
    Если Заказ.ЗаявкаНаРемонт <> Заявка.Ссылка Или Заказ.Запчасти.Количество() <> 1
        Или Заказ.Запчасти[0].Количество <> 2 Тогда
        ВызватьИсключение "Заказ по заявке должен содержать две недостающие детали.";
    КонецЕсли;

    Поставщик = Справочники.Поставщики.СоздатьЭлемент();
    Поставщик.Наименование = "Тестовый поставщик";
    Поставщик.Записать();
    Заказ.Поставщик = Поставщик.Ссылка;
    Заказ.Дата = ТекущаяДатаСеанса();
    Заказ.Запчасти[0].Количество = 5;
    Заказ.Записать();
    ПроверитьОжидание(Заказ.Ссылка, Поставщик.Ссылка, 0, 5);
    ПроверитьОстаток(Деталь, 2);

    ВторойЗаказ = Документы.ЗаказПоставщику.СоздатьДокумент();
    ВторойЗаказ.Заполнить(Заявка.Ссылка);
    Если ВторойЗаказ.Запчасти.Количество() <> 0 Тогда
        ВызватьИсключение "Открытый заказ не учтён при расчёте потребности.";
    КонецЕсли;

    ПерваяПоставка = НовоеПоступление(Заказ.Ссылка, Деталь, 3);
    ПерваяПоставка.Записать(РежимЗаписиДокумента.Проведение);
    ПерваяПоставка.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьОстаток(Деталь, 5);
    ПроверитьОжидание(Заказ.Ссылка, Поставщик.Ссылка, 3, 2);

    ВтораяПоставка = НовоеПоступление(Заказ.Ссылка, Деталь, 3);
    ПроверитьОтказ(ВтораяПоставка, РежимЗаписиДокумента.Проведение, "осталось получить 2 шт.");
    ПроверитьОстаток(Деталь, 5);
    ВтораяПоставка.Запчасти[0].Количество = 2;
    ВтораяПоставка.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьОжидание(Заказ.Ссылка, Поставщик.Ссылка, 5, 0);
    ПроверитьОстаток(Деталь, 7);

    Заказ.Запчасти[0].Количество = 4;
    ПроверитьОтказ(Заказ, РежимЗаписиДокумента.Запись, "Уже получено 5 шт.");
    ВтораяПоставка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
    ПроверитьОжидание(Заказ.Ссылка, Поставщик.Ссылка, 3, 2);
    ПроверитьОстаток(Деталь, 5);
КонецПроцедуры

Процедура ДобавитьПозицию(Документ, Деталь, Количество)
    Позиция = Документ.Запчасти.Добавить();
    Позиция.Запчасть = Деталь;
    Позиция.Количество = Количество;
КонецПроцедуры

Функция НовоеПоступление(Заказ, Деталь, Количество)
    Поступление = Документы.ПоступлениеЗапчастей.СоздатьДокумент();
    Поступление.Дата = ТекущаяДатаСеанса();
    Поступление.ЗаказПоставщику = Заказ;
    ДобавитьПозицию(Поступление, Деталь, Количество);
    Возврат Поступление;
КонецФункции

Процедура ПроверитьОжидание(Заказ, Поставщик, Получено, Осталось)
    Отчет = Отчеты.ОжидаемыеПоставки.Создать();
    Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
    Настройки = Схема.ВариантыНастроек[0].Настройки;
    Настройки.Отбор.Элементы[0].ПравоеЗначение = Поставщик;
    Настройки.Отбор.Элементы[0].Использование = Истина;
    Строки = СтрокиОтчета(Схема, Настройки);
    СтрокаОтчета = Строки.Найти(Заказ, "Заказ");
    Если Осталось = 0 Тогда
        Если СтрокаОтчета <> Неопределено Тогда
            ВызватьИсключение "Закрытая позиция осталась в отчёте.";
        КонецЕсли;
    ИначеЕсли СтрокаОтчета = Неопределено Или СтрокаОтчета.Получено <> Получено
        Или СтрокаОтчета.ОсталосьПолучить <> Осталось Тогда
        ВызватьИсключение "Отчёт неверно рассчитал исполнение заказа.";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСметуИГарантию(ИсходныйРемонт, Клиент, Мастер, Деталь)
    Заявка = Документы.ЗаявкаНаРемонт.СоздатьДокумент();
    Заявка.Дата = ТекущаяДатаСеанса();
    Заявка.Клиент = Клиент;
    Заявка.Мастер = Мастер;
    Заявка.Устройство = "Ноутбук";
    Заявка.Неисправность = "Не заряжается после ремонта";
    Заявка.Диагностика = "Требуется заменить разъём.";
    Заявка.СрокРемонта = НачалоДня(ТекущаяДатаСеанса()) - 86400;
    Заявка.Статус = Перечисления.СтатусыЗаявок.ВРаботе;
    Заявка.ИсходныйРемонт = ИсходныйРемонт;
    Работа = Заявка.Работы.Добавить();
    Работа.Работа = "Замена разъёма";
    Работа.Цена = 1500;
    Запчасть = Заявка.Запчасти.Добавить();
    Запчасть.Запчасть = Деталь;
    Запчасть.Количество = 1;
    Запчасть.Цена = 500;
    Заявка.Записать();
    Если Заявка.Ссылка.СуммаСметы <> 2000 Или Заявка.Ссылка.ИсходныйРемонт <> ИсходныйРемонт Тогда
        ВызватьИсключение "Не сохранена смета на 2 000 ₽ или связь с ремонтом.";
    КонецЕсли;
    ПроверитьОчередь(Заявка.Ссылка, Мастер);
    Заявка.ИсходныйРемонт = Заявка.Ссылка;
    ПроверитьОтказ(Заявка, РежимЗаписиДокумента.Запись, "Укажите другую завершённую заявку");
    Заявка.ИсходныйРемонт = ИсходныйРемонт;

    Заявка.Статус = Перечисления.СтатусыЗаявок.Готова;
    ПроверитьОтказ(Заявка, РежимЗаписиДокумента.Проведение, "Согласуйте текущую смету");
    Заявка.Статус = Перечисления.СтатусыЗаявок.ВРаботе;
    Согласовать(Заявка);
    Если Заявка.Ссылка.СогласованнаяСумма <> 2000 Или Не ЗначениеЗаполнено(Заявка.Ссылка.ДатаСогласования) Тогда
        ВызватьИсключение "Не сохранены дата и согласованная сумма.";
    КонецЕсли;

    Работа.Работа = "Восстановление пайки";
    Заявка.Записать();
    Если ЗначениеЗаполнено(Заявка.Ссылка.ДатаСогласования) Тогда
        ВызватьИсключение "Согласование сохранилось при изменении состава на ту же сумму.";
    КонецЕсли;
    Согласовать(Заявка);
    Заявка.Статус = Перечисления.СтатусыЗаявок.Готова;
    Заявка.Записать(РежимЗаписиДокумента.Проведение);
    ПроверитьСтатус(Заявка.Ссылка, Перечисления.СтатусыЗаявок.Готова);
    ПроверитьОстаток(Деталь, 2);

    Макет = Документы.ЗаявкаНаРемонт.ПолучитьМакет("ПФ_MXL_ЗаказНаряд");
    Смета = Макет.ПолучитьОбласть("Смета");
    Смета.Параметры.Сумма = Заявка.СогласованнаяСумма;
    Смета.Параметры.Согласовано = "Согласовано";
КонецПроцедуры

Процедура Согласовать(Заявка)
    Заявка.ДополнительныеСвойства.Вставить("СогласоватьСмету", Истина);
    Заявка.Записать();
КонецПроцедуры

Процедура ПроверитьОчередь(Заявка, Мастер)
    Отчет = Отчеты.ОчередьМастера.Создать();
    Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
    Настройки = Схема.ВариантыНастроек[0].Настройки;
    Настройки.Отбор.Элементы[0].ПравоеЗначение = Мастер;
    Настройки.Отбор.Элементы[0].Использование = Истина;
    Строки = СтрокиОтчета(Схема, Настройки);
    СтрокаОтчета = Строки.Найти(Заявка, "Заявка");
    Если СтрокаОтчета = Неопределено Или СтрокаОтчета.СостояниеСрока <> "Просрочен" Тогда
        ВызватьИсключение "Просроченная заявка не найдена в очереди мастера.";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтборОтчета(Деталь)
    Отчет = Отчеты.ЗапчастиНаСкладе.Создать();
    Схема = Отчет.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
    Настройки = Схема.ВариантыНастроек[0].Настройки;
    Если СтрокиОтчета(Схема, Настройки).Количество() <> 2 Тогда
        ВызватьИсключение "В отчёте без отбора ожидалось две складские позиции.";
    КонецЕсли;

    Отбор = Настройки.Отбор.Элементы[0];
    Отбор.ПравоеЗначение = Деталь;
    Отбор.Использование = Истина;
    Строки = СтрокиОтчета(Схема, Настройки);
    Если Строки.Количество() <> 1 Или Строки[0].Запчасть <> Деталь Или Строки[0].Количество <> 3 Тогда
        ВызватьИсключение "При отборе ожидалась одна строка по разъёму питания с остатком 3.";
    КонецЕсли;
КонецПроцедуры

Функция СтрокиОтчета(Схема, Настройки)
    Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
    Макет = Компоновщик.Выполнить(Схема, Настройки,,,
        Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
    Процессор = Новый ПроцессорКомпоновкиДанных;
    Процессор.Инициализировать(Макет);
    Вывод = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
    Таблица = Новый ТаблицаЗначений;
    Вывод.УстановитьОбъект(Таблица);
    Вывод.Вывести(Процессор);
    Возврат Таблица;
КонецФункции

Процедура ПроверитьСтатус(Ссылка, Ожидается)
    Если Ссылка.Статус <> Ожидается Тогда
        ВызватьИсключение СтрШаблон("Ожидался статус «%1», получено «%2».", Ожидается, Ссылка.Статус);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОстаток(Деталь, Ожидается)
    Запрос = Новый Запрос("ВЫБРАТЬ Остатки.КоличествоОстаток КАК Количество
        |ИЗ РегистрНакопления.ОстаткиЗапчастей.Остатки(, Запчасть = &Деталь) КАК Остатки");
    Запрос.УстановитьПараметр("Деталь", Деталь);
    Строки = Запрос.Выполнить().Выгрузить();
    Фактически = ?(Строки.Количество() = 0, 0, Строки[0].Количество);
    Если Фактически <> Ожидается Тогда
        ВызватьИсключение СтрШаблон("Ожидался остаток %1, получен %2.", Ожидается, Фактически);
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОтказ(Заявка, Режим, ОжидаемыйТекст)
    Попытка
        Заявка.Записать(Режим);
    Исключение
        Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
            Если СтрНайти(Сообщение.Текст, ОжидаемыйТекст) > 0 Тогда
                Возврат;
            КонецЕсли;
        КонецЦикла;
        ВызватьИсключение;
    КонецПопытки;
    ВызватьИсключение "Ожидался отказ: " + ОжидаемыйТекст;
КонецПроцедуры
