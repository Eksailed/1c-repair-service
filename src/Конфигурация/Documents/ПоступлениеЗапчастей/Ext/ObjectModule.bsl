Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    УчетЗапчастей.ПроверитьРежимЗаписи(ЭтотОбъект, РежимЗаписи, Отказ);
    Если ЗначениеЗаполнено(ЗаказПоставщику) Тогда
        УчетЗапчастей.ЗаблокироватьОстатки();
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если Запчасти.Количество() = 0 Тогда
        УчетЗапчастей.СообщитьОбОшибке(ЭтотОбъект, "Запчасти", "Добавьте хотя бы одну запчасть.", Отказ);
        Возврат;
    КонецЕсли;

    Если ЗначениеЗаполнено(ЗаказПоставщику) Тогда
        УчетЗапчастей.ПроверитьПоставку(ЭтотОбъект, Отказ);
    КонецЕсли;
    Если Не Отказ Тогда
        УчетЗапчастей.ЗаписатьДвижения(ЭтотОбъект, ВидДвиженияНакопления.Приход, Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    УчетЗапчастей.ОтменитьДвижения(ЭтотОбъект, Отказ);
КонецПроцедуры
