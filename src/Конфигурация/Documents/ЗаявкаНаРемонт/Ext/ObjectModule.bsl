Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

    Если ЭтоНовый() И Не ЗначениеЗаполнено(Статус) Тогда
        Статус = Перечисления.СтатусыЗаявок.Новая;
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Клиент) Тогда
        СообщитьОбОшибке("Клиент", "Укажите клиента.", Отказ);
    КонецЕсли;

    Если ПустаяСтрока(Устройство) Тогда
        СообщитьОбОшибке("Устройство", "Укажите устройство.", Отказ);
    КонецЕсли;

    Если ПустаяСтрока(Неисправность) Тогда
        СообщитьОбОшибке("Неисправность", "Опишите неисправность.", Отказ);
    КонецЕсли;

    Если Не ЗначениеЗаполнено(Статус) Тогда
        СообщитьОбОшибке("Статус", "Укажите статус заявки.", Отказ);
    КонецЕсли;

    Если (Статус = Перечисления.СтатусыЗаявок.ВРаботе
        Или Статус = Перечисления.СтатусыЗаявок.Готова)
        И Не ЗначениеЗаполнено(Мастер) Тогда
        СообщитьОбОшибке("Мастер", "Назначьте мастера.", Отказ);
    КонецЕсли;

    УчетЗапчастей.ПроверитьРежимЗаписи(ЭтотОбъект, РежимЗаписи, Отказ);
    ПроверитьИсходныйРемонт(Отказ);
    ОбновитьСмету(Отказ);
    Если ПометкаУдаления Или Статус <> Перечисления.СтатусыЗаявок.ВРаботе
        Или Не ЗначениеЗаполнено(ДатаСогласования) Тогда
        РезервироватьЗапчасти = Ложь;
    КонецЕсли;
    Если РежимЗаписи = РежимЗаписиДокумента.Проведение
        И (Работы.Количество() > 0 Или СуммаСметы > 0)
        И Не ЗначениеЗаполнено(ДатаСогласования) Тогда
        СообщитьОбОшибке("ДатаСогласования", "Согласуйте текущую смету с клиентом.", Отказ);
    КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
    УчетЗапчастей.ОбновитьРезерв(ЭтотОбъект, РезервироватьЗапчасти, Отказ);
КонецПроцедуры

Процедура ПроверитьИсходныйРемонт(Отказ)
    Если Не ЗначениеЗаполнено(ИсходныйРемонт) Тогда
        Возврат;
    КонецЕсли;

    Если ИсходныйРемонт = Ссылка Или ИсходныйРемонт.ПометкаУдаления
        Или ИсходныйРемонт.Статус <> Перечисления.СтатусыЗаявок.Готова
        Или ИсходныйРемонт.Клиент <> Клиент Тогда
        СообщитьОбОшибке("ИсходныйРемонт",
            "Укажите другую завершённую заявку этого клиента без пометки удаления.", Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ОбновитьСмету(Отказ)
    СуммаСметы = 0;
    Для Каждого СтрокаРабот Из Работы Цикл
        Если ПустаяСтрока(СтрокаРабот.Работа) Или СтрокаРабот.Цена < 0 Тогда
            СообщитьОбОшибке("Работы", "Укажите название работы и цену от нуля.", Отказ);
            Возврат;
        КонецЕсли;
        СуммаСметы = СуммаСметы + СтрокаРабот.Цена;
    КонецЦикла;
    Для Каждого СтрокаДеталей Из Запчасти Цикл
        Если СтрокаДеталей.Цена < 0 Тогда
            СообщитьОбОшибке("Запчасти", "Цена запчасти не может быть отрицательной.", Отказ);
            Возврат;
        КонецЕсли;
        СуммаСметы = СуммаСметы + СтрокаДеталей.Цена * СтрокаДеталей.Количество;
    КонецЦикла;

    Согласовать = Ложь;
    Если ДополнительныеСвойства.Свойство("СогласоватьСмету", Согласовать)
        И Согласовать = Истина Тогда
        ДополнительныеСвойства.Удалить("СогласоватьСмету");
        Если Работы.Количество() = 0 И СуммаСметы = 0 Тогда
            СообщитьОбОшибке("Работы", "Добавьте работу или укажите стоимость запчасти.", Отказ);
        Иначе
            ДатаСогласования = ТекущаяДатаСеанса();
            СогласованнаяСумма = СуммаСметы;
        КонецЕсли;
        Возврат;
    КонецЕсли;

    Если Не ЭтоНовый() И ЗначениеЗаполнено(Ссылка.ДатаСогласования) Тогда
        Предыдущая = Ссылка.ПолучитьОбъект();
        Если СоставСметы() = Предыдущая.СоставСметы() Тогда
            ДатаСогласования = Предыдущая.ДатаСогласования;
            СогласованнаяСумма = Предыдущая.СогласованнаяСумма;
            Возврат;
        КонецЕсли;
    КонецЕсли;
    ДатаСогласования = Дата(1, 1, 1);
    СогласованнаяСумма = 0;
КонецПроцедуры

Функция СоставСметы() Экспорт
    Позиции = Новый Массив;
    Позиции.Добавить(Клиент);
    Позиции.Добавить(Устройство);
    Для Каждого СтрокаРабот Из Работы Цикл
        Позиции.Добавить(Новый Структура("Работа,Цена", СтрокаРабот.Работа, СтрокаРабот.Цена));
    КонецЦикла;
    Для Каждого СтрокаДеталей Из Запчасти Цикл
        Позиции.Добавить(Новый Структура("Запчасть,Количество,Цена",
            СтрокаДеталей.Запчасть, СтрокаДеталей.Количество, СтрокаДеталей.Цена));
    КонецЦикла;
    Возврат ЗначениеВСтрокуВнутр(Позиции);
КонецФункции

Процедура СообщитьОбОшибке(ИмяПоля, ТекстОшибки, Отказ)

    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = ТекстОшибки;
    Сообщение.Поле = ИмяПоля;
    Сообщение.УстановитьДанные(ЭтотОбъект);
    Сообщение.Сообщить();
    Отказ = Истина;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

    Если Статус <> Перечисления.СтатусыЗаявок.Готова Тогда
        СообщитьОбОшибке("Статус", "Провести можно только готовую заявку.", Отказ);
        Возврат;
    КонецЕсли;

    УчетЗапчастей.ОбновитьРезерв(ЭтотОбъект, Ложь, Отказ);
    УчетЗапчастей.ЗаписатьДвижения(ЭтотОбъект, ВидДвиженияНакопления.Расход, Отказ);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    УчетЗапчастей.ОтменитьДвижения(ЭтотОбъект, Отказ);
КонецПроцедуры
