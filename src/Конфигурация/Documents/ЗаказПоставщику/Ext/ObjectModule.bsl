
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
    Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
        Основание = Неопределено;
        Если Не ДанныеЗаполнения.Свойство("РемонтДляЗакупки", Основание) Тогда
            Возврат;
        КонецЕсли;
        ДанныеЗаполнения = Основание;
    КонецЕсли;
    Если ТипЗнч(ДанныеЗаполнения) <> Тип("ДокументСсылка.ЗаявкаНаРемонт") Тогда
        Возврат;
    КонецЕсли;
    ЗаявкаНаРемонт = ДанныеЗаполнения;
    Запчасти.Загрузить(УчетЗапчастей.НедостающиеЗапчасти(ДанныеЗаполнения));
    Если Запчасти.Количество() = 0 Тогда
        Сообщить("По заявке нет недостающих деталей с учётом открытых заказов.");
    КонецЕсли;
    СтандартнаяОбработка = Ложь;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
    УчетЗапчастей.ЗаблокироватьОстатки();
    Если Не ПометкаУдаления Тогда
        Если Не ЗначениеЗаполнено(Поставщик) Тогда
            УчетЗапчастей.СообщитьОбОшибке(ЭтотОбъект, "Поставщик", "Укажите поставщика.", Отказ);
        КонецЕсли;
        Если Запчасти.Количество() = 0 Тогда
            УчетЗапчастей.СообщитьОбОшибке(ЭтотОбъект, "Запчасти", "Добавьте запчасти в заказ.", Отказ);
        КонецЕсли;
        Для Каждого СтрокаЗапчастей Из Запчасти Цикл
            Если Не ЗначениеЗаполнено(СтрокаЗапчастей.Запчасть) Или СтрокаЗапчастей.Количество <= 0 Тогда
                УчетЗапчастей.СообщитьОбОшибке(ЭтотОбъект, "Запчасти", "Укажите запчасть и положительное количество.", Отказ);
                Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если Не Отказ Тогда
        УчетЗапчастей.ПроверитьИзменениеЗаказа(ЭтотОбъект, Отказ);
    КонецЕсли;
КонецПроцедуры
