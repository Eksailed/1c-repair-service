&НаКлиенте
Процедура ВзятьВРаботу(Команда)
    Если ЗначениеЗаполнено(Объект.Статус)
        И Объект.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЗаявок.Новая") Тогда
        Сообщить("Взять в работу можно новую заявку.");
        Возврат;
    КонецЕсли;
    СменитьСтатус("ВРаботе", РежимЗаписиДокумента.Запись);
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРемонт(Команда)
    Если Объект.Статус <> ПредопределенноеЗначение("Перечисление.СтатусыЗаявок.ВРаботе") Тогда
        Сообщить("Сначала возьмите заявку в работу.");
        Возврат;
    КонецЕсли;
    СменитьСтатус("Готова", РежимЗаписиДокумента.Проведение);
КонецПроцедуры

&НаКлиенте
Процедура СменитьСтатус(ИмяСтатуса, РежимЗаписи)
    ПрежнийСтатус = Объект.Статус;
    Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявок." + ИмяСтатуса);
    Попытка
        Если Не Записать(Новый Структура("РежимЗаписи", РежимЗаписи)) Тогда
            Объект.Статус = ПрежнийСтатус;
        КонецЕсли;
    Исключение
        Объект.Статус = ПрежнийСтатус;
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказатьНедостающее(Команда)
    Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
        Сообщить("Сохраните заявку перед заказом запчастей.");
        Возврат;
    КонецЕсли;
    Если Объект.Статус = ПредопределенноеЗначение("Перечисление.СтатусыЗаявок.Готова") Тогда
        Сообщить("Для завершённого ремонта заказ не создаётся.");
        Возврат;
    КонецЕсли;
    Заполнение = Новый Структура("РемонтДляЗакупки", Объект.Ссылка);
    ОткрытьФорму("Документ.ЗаказПоставщику.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", Заполнение));
КонецПроцедуры

&НаКлиенте
Процедура СогласоватьСмету(Команда)
    Режим = ?(Объект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
    Записать(Новый Структура("РежимЗаписи,СогласоватьСмету", Режим, Истина));
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Если ПараметрыЗаписи.Свойство("СогласоватьСмету") Тогда
        ТекущийОбъект.ДополнительныеСвойства.Вставить("СогласоватьСмету", Истина);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаказНаряд(Команда)
    Если Не ЗначениеЗаполнено(Объект.Ссылка) Или Модифицированность Тогда
        Сообщить("Сохраните заявку перед просмотром заказ-наряда.");
        Возврат;
    КонецЕсли;
    Наряд = СформироватьЗаказНаряд(Объект.Ссылка);
    Наряд.Показать("Заказ-наряд");
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьЗаказНаряд(Ссылка)
    Заявка = Ссылка.ПолучитьОбъект();
    Макет = Документы.ЗаявкаНаРемонт.ПолучитьМакет("ПФ_MXL_ЗаказНаряд");
    Наряд = Новый ТабличныйДокумент;
    Наряд.ИмяПараметровПечати = "ЗаказНарядРемонта";
    Наряд.АвтоМасштаб = Истина;
    Наряд.ОтображатьСетку = Ложь;
    Наряд.ОтображатьЗаголовки = Ложь;
    Шапка = Макет.ПолучитьОбласть("Шапка");
    Шапка.Параметры.Заголовок = СтрШаблон("Заказ-наряд № %1 от %2", Заявка.Номер, Формат(Заявка.Дата, "ДФ=dd.MM.yyyy"));
    Шапка.Параметры.Клиент = Строка(Заявка.Клиент);
    Шапка.Параметры.Устройство = Заявка.Устройство;
    Шапка.Параметры.Неисправность = Заявка.Неисправность;
    Шапка.Параметры.Мастер = Строка(Заявка.Мастер);
    Шапка.Параметры.Статус = Строка(Заявка.Статус);
    Наряд.Вывести(Шапка);

    Если ЗначениеЗаполнено(Заявка.Диагностика) Тогда
        Диагностика = Макет.ПолучитьОбласть("Диагностика");
        Диагностика.Параметры.Результат = Заявка.Диагностика;
        Наряд.Вывести(Диагностика);
    КонецЕсли;

    Если Заявка.Работы.Количество() > 0 Тогда
        Наряд.Вывести(Макет.ПолучитьОбласть("ШапкаРабот"));
        Работа = Макет.ПолучитьОбласть("Работа");
        Для Каждого СтрокаРабот Из Заявка.Работы Цикл
            Работа.Параметры.Наименование = СтрокаРабот.Работа;
            Работа.Параметры.Цена = СтрокаРабот.Цена;
            Наряд.Вывести(Работа);
        КонецЦикла;
    КонецЕсли;

    Сводка = Заявка.Запчасти.Выгрузить(, "Запчасть, Количество, Цена");
    Если Сводка.Количество() = 0 Тогда
        Наряд.Вывести(Макет.ПолучитьОбласть("БезЗапчастей"));
    Иначе
        Сводка.Свернуть("Запчасть, Цена", "Количество");
        Наряд.Вывести(Макет.ПолучитьОбласть("ШапкаДеталей"));
        Область = Макет.ПолучитьОбласть("Деталь");
        Для Каждого СтрокаСводки Из Сводка Цикл
            Наименование = Строка(СтрокаСводки.Запчасть);
            Если СтрокаСводки.Цена > 0 Тогда
                Наименование = СтрШаблон("%1 (%2 ₽/шт.)", Наименование, СтрокаСводки.Цена);
            КонецЕсли;
            Область.Параметры.Запчасть = Наименование;
            Область.Параметры.Количество = СтрокаСводки.Количество;
            Наряд.Вывести(Область);
        КонецЦикла;
    КонецЕсли;
    Если Заявка.Работы.Количество() > 0 Или Заявка.СуммаСметы > 0 Тогда
        Итог = Макет.ПолучитьОбласть("Смета");
        Итог.Параметры.Сумма = Заявка.СуммаСметы;
        Итог.Параметры.Согласовано = ?(ЗначениеЗаполнено(Заявка.ДатаСогласования),
            СтрШаблон("%1 ₽ от %2", Заявка.СогласованнаяСумма, Формат(Заявка.ДатаСогласования, "ДФ=dd.MM.yyyy")),
            "Ожидает согласования");
        Наряд.Вывести(Итог);
    КонецЕсли;
    Возврат Наряд;
КонецФункции
