Процедура ПроверитьРежимЗаписи(Документ, РежимЗаписи, Отказ) Экспорт
    Если РежимЗаписи = РежимЗаписиДокумента.Запись
        И (Документ.Проведен Или (Не Документ.ЭтоНовый() И Документ.Ссылка.Проведен)) Тогда
        СообщитьОбОшибке(Документ, "", "Для сохранения изменений перепроведите документ.", Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьДвижения(Документ, ВидДвижения, Отказ) Экспорт
    Если Документ.Запчасти.Количество() > 0
        И НачалоДня(Документ.Дата) <> НачалоДня(ТекущаяДатаСеанса()) Тогда
        СообщитьОбОшибке(Документ, "Дата", "Складской документ можно провести только текущей датой.", Отказ);
        Возврат;
    КонецЕсли;

    Для Каждого СтрокаЗапчастей Из Документ.Запчасти Цикл
        Если Не ЗначениеЗаполнено(СтрокаЗапчастей.Запчасть) Или СтрокаЗапчастей.Количество <= 0 Тогда
            СообщитьОбОшибке(Документ, "Запчасти", "Укажите запчасть и количество больше нуля в каждой строке.", Отказ);
            Возврат;
        КонецЕсли;
    КонецЦикла;

    Сводка = Документ.Запчасти.Выгрузить(, "Запчасть, Количество");
    Сводка.Свернуть("Запчасть", "Количество");
    ЗаблокироватьОстатки();
    Набор = Документ.Движения.ОстаткиЗапчастей;
    Набор.Очистить();
    Для Каждого СтрокаЗапчастей Из Сводка Цикл
        Движение = Набор.Добавить();
        Движение.Период = Документ.Дата;
        Движение.ВидДвижения = ВидДвижения;
        Движение.Запчасть = СтрокаЗапчастей.Запчасть;
        Движение.Количество = СтрокаЗапчастей.Количество;
    КонецЦикла;
    Набор.Записать();
    ПроверитьОстатки(Документ, Сводка, ВидДвижения = ВидДвиженияНакопления.Расход, Отказ);
    Если Не Отказ Тогда
        ПроверитьПокрытиеРезервов(Документ, Сводка, ВидДвижения = ВидДвиженияНакопления.Расход, Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ОтменитьДвижения(Документ, Отказ) Экспорт
    ЗаблокироватьОстатки();
    Набор = Документ.Движения.ОстаткиЗапчастей;
    Набор.Очистить();
    Набор.Записать();
    ПроверитьОстатки(Документ, Неопределено, Ложь, Отказ);
    Если Не Отказ Тогда
        ПроверитьПокрытиеРезервов(Документ, Неопределено, Ложь, Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ОбновитьРезерв(Заявка, Резервировать, Отказ) Экспорт
    ЗаблокироватьОстатки();
    Набор = РегистрыСведений.РезервыЗапчастей.СоздатьНаборЗаписей();
    Набор.Отбор.Заявка.Установить(Заявка.Ссылка);
    Если Не Резервировать Тогда
        Набор.Записать();
        Возврат;
    КонецЕсли;

    Если Заявка.Запчасти.Количество() = 0 Тогда
        СообщитьОбОшибке(Заявка, "Запчасти", "Добавьте детали для резерва.", Отказ);
        Возврат;
    КонецЕсли;
    Для Каждого СтрокаДеталей Из Заявка.Запчасти Цикл
        Если Не ЗначениеЗаполнено(СтрокаДеталей.Запчасть) Или СтрокаДеталей.Количество <= 0 Тогда
            СообщитьОбОшибке(Заявка, "Запчасти", "Укажите запчасть и положительное количество для резерва.", Отказ);
            Возврат;
        КонецЕсли;
    КонецЦикла;

    Позиции = СвернутьЗапчасти(Заявка.Запчасти);
    Для Каждого Позиция Из Позиции Цикл
        СтрокаРезерва = Набор.Добавить();
        СтрокаРезерва.Заявка = Заявка.Ссылка;
        СтрокаРезерва.Запчасть = Позиция.Запчасть;
        СтрокаРезерва.Количество = Позиция.Количество;
    КонецЦикла;
    Набор.Записать();
    ПроверитьПокрытиеРезервов(Заявка, Позиции, Истина, Отказ);
КонецПроцедуры

Процедура ПроверитьПокрытиеРезервов(Документ, Позиции, ЕстьРасход, Отказ)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ Резервы.Запчасть КАК Запчасть, СУММА(Резервы.Количество) КАК Количество
        |ПОМЕСТИТЬ ИтогиРезервов
        |ИЗ РегистрСведений.РезервыЗапчастей КАК Резервы
        |СГРУППИРОВАТЬ ПО Резервы.Запчасть
        |;
        |ВЫБРАТЬ Резервы.Запчасть КАК Запчасть,
        |    Резервы.Количество - ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Дефицит
        |ИЗ ИтогиРезервов КАК Резервы
        |    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЗапчастей.Остатки() КАК Остатки
        |    ПО Резервы.Запчасть = Остатки.Запчасть
        |ГДЕ Резервы.Количество > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Позиция = ?(ЕстьРасход, Позиции.Найти(Выборка.Запчасть, "Запчасть"), Неопределено);
        Если Позиция = Неопределено Тогда
            Текст = СтрШаблон("После операции не хватит запчасти «%1» для действующих резервов: %2 шт.",
                Выборка.Запчасть, Выборка.Дефицит);
        Иначе
            Текст = СтрШаблон("Запчасть «%1»: нужно %2, доступно %3 с учётом резервов.",
                Выборка.Запчасть, Позиция.Количество, Позиция.Количество - Выборка.Дефицит);
        КонецЕсли;
        СообщитьОбОшибке(Документ, "Запчасти", Текст, Отказ);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаблокироватьОстатки() Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиЗапчастей");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПроверитьОстатки(Документ, Сводка, ЭтоРасход, Отказ)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |   Остатки.Запчасть КАК Запчасть,
        |   Остатки.КоличествоОстаток КАК Остаток
        |ИЗ
        |   РегистрНакопления.ОстаткиЗапчастей.Остатки() КАК Остатки
        |ГДЕ
        |   Остатки.КоличествоОстаток < 0");
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        СтрокаСводки = ?(ЭтоРасход, Сводка.Найти(Выборка.Запчасть, "Запчасть"), Неопределено);
        Если СтрокаСводки <> Неопределено Тогда
            Количество = СтрокаСводки.Количество;
            Текст = СтрШаблон("Запчасть «%1»: нужно %2, доступно %3.",
                Выборка.Запчасть, Количество, Количество + Выборка.Остаток);
        Иначе
            Текст = СтрШаблон("После операции не хватит запчасти «%1»: %2 шт.",
                Выборка.Запчасть, -Выборка.Остаток);
        КонецЕсли;
        СообщитьОбОшибке(Документ, "Запчасти", Текст, Отказ);
    КонецЦикла;
КонецПроцедуры

Процедура СообщитьОбОшибке(Документ, Поле, Текст, Отказ) Экспорт
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.Поле = Поле;
    Сообщение.УстановитьДанные(Документ);
    Сообщение.Сообщить();
    Отказ = Истина;
КонецПроцедуры
Функция НедостающиеЗапчасти(Заявка) Экспорт
    Запрос = Новый Запрос(
        "ВЫБРАТЬ
        |   Строки.Запчасть КАК Запчасть,
        |   СУММА(Строки.Количество) КАК Потребность
        |ПОМЕСТИТЬ Нужно
        |ИЗ Документ.ЗаявкаНаРемонт.Запчасти КАК Строки
        |ГДЕ Строки.Ссылка = &Заявка
        |СГРУППИРОВАТЬ ПО Строки.Запчасть
        |;
        |ВЫБРАТЬ Движения.Запчасть КАК Запчасть, СУММА(Движения.Количество) КАК Ожидается
        |ПОМЕСТИТЬ Ожидаемые
        |ИЗ (ВЫБРАТЬ Строки.Запчасть КАК Запчасть, Строки.Количество КАК Количество
        |    ИЗ Документ.ЗаказПоставщику.Запчасти КАК Строки
        |    ГДЕ Строки.Ссылка.ЗаявкаНаРемонт = &Заявка И НЕ Строки.Ссылка.ПометкаУдаления
        |    ОБЪЕДИНИТЬ ВСЕ
        |    ВЫБРАТЬ Строки.Запчасть, -Строки.Количество
        |    ИЗ Документ.ПоступлениеЗапчастей.Запчасти КАК Строки
        |    ГДЕ Строки.Ссылка.ЗаказПоставщику.ЗаявкаНаРемонт = &Заявка И Строки.Ссылка.Проведен) КАК Движения
        |СГРУППИРОВАТЬ ПО Движения.Запчасть
        |;
        |ВЫБРАТЬ Резервы.Запчасть КАК Запчасть, СУММА(Резервы.Количество) КАК Количество
        |ПОМЕСТИТЬ ЧужиеРезервы
        |ИЗ РегистрСведений.РезервыЗапчастей КАК Резервы
        |ГДЕ Резервы.Заявка <> &Заявка И Резервы.Запчасть В (ВЫБРАТЬ Нужно.Запчасть ИЗ Нужно КАК Нужно)
        |СГРУППИРОВАТЬ ПО Резервы.Запчасть
        |;
        |ВЫБРАТЬ Нужно.Запчасть КАК Запчасть,
        |    Нужно.Потребность - ЕСТЬNULL(Остатки.КоличествоОстаток, 0)
        |        + ЕСТЬNULL(ЧужиеРезервы.Количество, 0) - ЕСТЬNULL(Ожидаемые.Ожидается, 0) КАК Количество
        |ИЗ Нужно КАК Нужно
        |    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиЗапчастей.Остатки() КАК Остатки
        |    ПО Нужно.Запчасть = Остатки.Запчасть
        |    ЛЕВОЕ СОЕДИНЕНИЕ Ожидаемые КАК Ожидаемые
        |    ПО Нужно.Запчасть = Ожидаемые.Запчасть
        |    ЛЕВОЕ СОЕДИНЕНИЕ ЧужиеРезервы КАК ЧужиеРезервы
        |    ПО Нужно.Запчасть = ЧужиеРезервы.Запчасть
        |ГДЕ Нужно.Потребность > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)
        |    - ЕСТЬNULL(ЧужиеРезервы.Количество, 0) + ЕСТЬNULL(Ожидаемые.Ожидается, 0)");
    Запрос.УстановитьПараметр("Заявка", Заявка);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПроверитьПоставку(Документ, Отказ) Экспорт
    Заказ = Документ.ЗаказПоставщику;
    Если Заказ.ПометкаУдаления Тогда
        СообщитьОбОшибке(Документ, "ЗаказПоставщику", "Заказ поставщику помечен на удаление.", Отказ);
        Возврат;
    КонецЕсли;

    Заказано = СвернутьЗапчасти(Заказ.ПолучитьОбъект().Запчасти);
    Получено = ПолученныеЗапчасти(Заказ, Документ.Ссылка);
    Для Каждого Позиция Из СвернутьЗапчасти(Документ.Запчасти) Цикл
        СтрокаЗаказа = Заказано.Найти(Позиция.Запчасть, "Запчасть");
        СтрокаПоставки = Получено.Найти(Позиция.Запчасть, "Запчасть");
        Осталось = ?(СтрокаЗаказа = Неопределено, 0, СтрокаЗаказа.Количество)
            - ?(СтрокаПоставки = Неопределено, 0, СтрокаПоставки.Количество);
        Если Позиция.Количество > Осталось Тогда
            Текст = СтрШаблон("По заказу «%1» осталось получить %2 шт. запчасти «%3».",
                Заказ, Осталось, Позиция.Запчасть);
            СообщитьОбОшибке(Документ, "Запчасти", Текст, Отказ);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьИзменениеЗаказа(Заказ, Отказ) Экспорт
    Если Заказ.ЭтоНовый() Тогда
        Возврат;
    КонецЕсли;

    Получено = ПолученныеЗапчасти(Заказ.Ссылка, Документы.ПоступлениеЗапчастей.ПустаяСсылка());
    Если Получено.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;

    Если Заказ.ПометкаУдаления Или Заказ.Поставщик <> Заказ.Ссылка.Поставщик
        Или Заказ.ЗаявкаНаРемонт <> Заказ.Ссылка.ЗаявкаНаРемонт Тогда
        СообщитьОбОшибке(Заказ, "", "Сначала отмените проведённые поступления по заказу.", Отказ);
        Возврат;
    КонецЕсли;

    Заказано = СвернутьЗапчасти(Заказ.Запчасти);
    Для Каждого СтрокаПоставки Из Получено Цикл
        СтрокаЗаказа = Заказано.Найти(СтрокаПоставки.Запчасть, "Запчасть");
        Если СтрокаЗаказа = Неопределено Или СтрокаЗаказа.Количество < СтрокаПоставки.Количество Тогда
            СообщитьОбОшибке(Заказ, "Запчасти",
                СтрШаблон("Уже получено %1 шт. запчасти «%2».", СтрокаПоставки.Количество, СтрокаПоставки.Запчасть), Отказ);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПолученныеЗапчасти(Заказ, ИсключитьПоступление)
    Запрос = Новый Запрос(
        "ВЫБРАТЬ Строки.Запчасть КАК Запчасть, СУММА(Строки.Количество) КАК Количество
        |ИЗ Документ.ПоступлениеЗапчастей.Запчасти КАК Строки
        |ГДЕ Строки.Ссылка.ЗаказПоставщику = &Заказ
        |    И Строки.Ссылка.Проведен И Строки.Ссылка <> &Исключить
        |СГРУППИРОВАТЬ ПО Строки.Запчасть");
    Запрос.УстановитьПараметр("Заказ", Заказ);
    Запрос.УстановитьПараметр("Исключить", ИсключитьПоступление);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СвернутьЗапчасти(Запчасти)
    Таблица = Запчасти.Выгрузить(, "Запчасть, Количество");
    Таблица.Свернуть("Запчасть", "Количество");
    Возврат Таблица;
КонецФункции
