	<dataSet xsi:type="DataSetQuery">
		<name>Заявки</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Запчасть</dataPath>
			<field>Запчасть</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Количество</dataPath>
			<field>Количество</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>На складе</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ВРезерве</dataPath>
			<field>ВРезерве</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>В резерве</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Доступно</dataPath>
			<field>Доступно</field>
		</field>
		<dataSource>Источник</dataSource>
		<query>ВЫБРАТЬ
    Резервы.Запчасть КАК Запчасть,
    СУММА(Резервы.Количество) КАК Зарезервировано
ПОМЕСТИТЬ РезервыПоЗапчастям
ИЗ
    РегистрСведений.РезервыЗапчастей КАК Резервы
СГРУППИРОВАТЬ ПО
    Резервы.Запчасть
;
ВЫБРАТЬ
    Остатки.Запчасть КАК Запчасть,
    Остатки.КоличествоОстаток КАК Количество,
    ЕСТЬNULL(Резервы.Зарезервировано, 0) КАК ВРезерве,
    Остатки.КоличествоОстаток - ЕСТЬNULL(Резервы.Зарезервировано, 0) КАК Доступно
ИЗ
    РегистрНакопления.ОстаткиЗапчастей.Остатки() КАК Остатки
    ЛЕВОЕ СОЕДИНЕНИЕ РезервыПоЗапчастям КАК Резервы
    ПО Остатки.Запчасть = Резервы.Запчасть
УПОРЯДОЧИТЬ ПО
    Запчасть</query>
	</dataSet>
